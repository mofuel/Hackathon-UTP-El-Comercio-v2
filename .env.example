# Configuración pública de ejemplo para el cliente Flutter (Supabase)
# Copia estos valores al ejecutar o compilar mediante --dart-define:
#   flutter run \
#     --dart-define=SUPABASE_URL=https://tu-proyecto.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=tu-anon-key-publica
#
# IMPORTANTE:
# Nunca coloques SUPABASE_SERVICE_ROLE_KEY ni claves secretas en la app móvil ni en el repositorio.

SUPABASE_URL=https://example-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-public-anon-key
DEFAULT_NEIGHBORHOOD=Pueblo Libre
DEFAULT_SECTOR=Sector San Martín

# Selección del backend Azure mediante --dart-define. Usa una API HTTPS
# o http://10.0.2.2:3000 desde un emulador Android en modo debug.
# CONECTA2_API_URL=
# ENTRA_TENANT_SUBDOMAIN=
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# ENTRA_MOBILE_CLIENT_ID=

# Firebase Cloud Messaging (opcional). Agrega los valores públicos al JSON local.
# FIREBASE_PROJECT_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_ANDROID_APP_ID=
# FIREBASE_ANDROID_API_KEY=
# FIREBASE_IOS_APP_ID=
# FIREBASE_IOS_API_KEY=
